require(COMPoissonReg)
require(mcglm)
require(glmtoolbox)
require(GLMsData)
require(gamlss)
require(gamlss.data)
require(tidyverse)
require(insuranceData)
data("polyps")
polyps$Treatment=factor(polyps$Treatment,c("Placebo","Drug"),
c("Placebo","Medicamento"))
set.seed(999)
polyps=polyps[sample(nrow(polyps)),]
attach(polyps)
fit3=gamlss(Number~Age+Treatment, sigma.formula = ~ Treatment,
family=NBI(mu.link = "log",sigma.link = "log"));summary(fit3)
fit3=gamlss(Number~Age+Treatment, sigma.formula = ~ Treatment,
family=NBI(mu.link = "log",sigma.link = "log"));summary(fit3,use.t=F)
fit3=gamlss(Number~Age+Treatment, sigma.formula = ~ Treatment,
family=NBI(mu.link = "log",sigma.link = "log"));summary(fit3,robust = F)
?robust
coef_tab <- summary(fit3)
z_value <- coef_tab[, "Estimate"] / coef_tab[, "Std. Error"]
p_value_norm <- 2 * pnorm(abs(z_value), lower.tail = FALSE)
p_value_norm
summary(fit3)
data(hcrabs)
hcrabs$Wt=hcrabs$Wt/1000
hcrabs$Col=factor(hcrabs$Col,rev(c("D","DM","M","LM")),
rev(c("Escura","Média Escura","Média","Média Clara")))
hcrabs$Spine=factor(hcrabs$Spine,c("NoneOK","OneOK","BothOK"),
rev(c("Nenhuma em Bom Estado","Uma em Bom Estado","Ambas em Bom Estado")))
attach(hcrabs)
fit5=gamlss(Sat~Wt + Col,sigma.formula = ~ Col,
nu.formula = ~ 1,tau.formula = ~ Col,#data=hcrabs[-c(15,56,149),],
family=ZISICHEL(tau.link = "logit"),data=hcrabs);summary(fit5)
coef_tab <- summary(fit5)
z_value <- coef_tab[, "Estimate"] / coef_tab[, "Std. Error"]
p_value_norm <- 2 * pnorm(abs(z_value), lower.tail = FALSE)
summary(fit5)
p_value_norm
summary(fit5)
p_value_norm
require(statmod)
statmod::wald.test(fit5, terms = 2:3)
statmod::wald.test(fit3, terms = 2:3)
coef_tab <- summary(fit3)
z_value <- coef_tab[, "Estimate"] / coef_tab[, "Std. Error"]
z_value
coef_tab <- summary(fit5)
z_value <- coef_tab[, "Estimate"] / coef_tab[, "Std. Error"]
z_value <- coef_tab[, "Estimate"] / coef_tab[, "Std. Error"]
p_value_norm <- 2 * pnorm(abs(z_value), lower.tail = FALSE)
p_value_norm <- 2 * pnorm(abs(z_value), lower.tail = FALSE);p_value_norm
fit3=gamlss(Number~Age+Treatment, sigma.formula = ~ Treatment,
family=NBI(mu.link = "log",sigma.link = "log"));summary(fit3)
coef_tab <- summary(fit3)
z_value <- coef_tab[, "Estimate"] / coef_tab[, "Std. Error"]
p_value_norm <- 2 * pnorm(abs(z_value), lower.tail = FALSE)
p_value_norm <- 2 * pnorm(abs(z_value), lower.tail = FALSE);p_value_norm
